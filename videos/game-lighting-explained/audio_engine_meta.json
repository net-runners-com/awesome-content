  "voices": [
    {
      "id": "01",
      "path": "assets/voice/01.wav",
      "duration_s": 6.954,
      "words": [
        {
          "id": "w0",
          "text": "ゲームの画面の印象を決めるのは、",
          "start": 0.05,
          "end": 3.252
        },
        {
          "id": "w1",
          "text": "モデルでもテクスチャでもない。",
          "start": 3.252,
          "end": 6.254
        },
        {
          "id": "w2",
          "text": "光だ。",
          "start": 6.254,
          "end": 6.854
        }
      ]
    },
    {
      "id": "02",
      "path": "assets/voice/02.wav",
      "duration_s": 11.555,
      "words": [
        {
          "id": "w0",
          "text": "リアルタイムレンダリングの光源は、",
          "start": 0.05,
          "end": 3.177
        },
        {
          "id": "w1",
          "text": "実質この3つ。",
          "start": 3.177,
          "end": 4.465
        },
        {
          "id": "w2",
          "text": "点光源、",
          "start": 4.465,
          "end": 5.201
        },
        {
          "id": "w3",
          "text": "ディレクショナルライト、",
          "start": 5.201,
          "end": 7.408
        },
        {
          "id": "w4",
          "text": "そして環境光。",
          "start": 7.408,
          "end": 8.696
        },
        {
          "id": "w5",
          "text": "名前だけ、",
          "start": 8.696,
          "end": 9.615
        },
        {
          "id": "w6",
          "text": "まず覚えてしまおう。",
          "start": 9.615,
          "end": 11.455
        }
      ]
    },
    {
      "id": "03",
      "path": "assets/voice/03.wav",
      "duration_s": 16.658,
      "words": [
        {
          "id": "w0",
          "text": "点光源は、",
          "start": 0.05,
          "end": 1.095
        },
        {
          "id": "w1",
          "text": "一点から全方向に光を放つ。",
          "start": 1.095,
          "end": 3.811
        },
        {
          "id": "w2",
          "text": "たいまつ、",
          "start": 3.811,
          "end": 4.856
        },
        {
          "id": "w3",
          "text": "ランプ、",
          "start": 4.856,
          "end": 5.692
        },
        {
          "id": "w4",
          "text": "マズルフラッシュ。",
          "start": 5.692,
          "end": 7.573
        },
        {
          "id": "w5",
          "text": "特徴は、",
          "start": 7.573,
          "end": 8.408
        },
        {
          "id": "w6",
          "text": "距離とともに急激に暗くなること。",
          "start": 8.408,
          "end": 11.752
        },
        {
          "id": "w7",
          "text": "拾えるアイテムの光など、",
          "start": 11.752,
          "end": 14.259
        },
        {
          "id": "w8",
          "text": "視線誘導にも使われる。",
          "start": 14.259,
          "end": 16.558
        }
      ]
    },
    {
      "id": "04",
      "path": "assets/voice/04.wav",
      "duration_s": 14.14,
      "words": [
        {
          "id": "w0",
          "text": "物理では逆二乗則。",
          "start": 0.05,
          "end": 2.017
        },
        {
          "id": "w1",
          "text": "距離が2倍なら、",
          "start": 2.017,
          "end": 3.766
        },
        {
          "id": "w2",
          "text": "明るさは4分の1。",
          "start": 3.766,
          "end": 5.733
        },
        {
          "id": "w3",
          "text": "エンジンでは係数付きの減衰式でカーブを調整し、",
          "start": 5.733,
          "end": 10.761
        },
        {
          "id": "w4",
          "text": "減衰半径の外は計算を打ち切る。",
          "start": 10.761,
          "end": 14.04
        }
      ]
    },
    {
      "id": "05",
      "path": "assets/voice/05.wav",
      "duration_s": 15.147,
      "words": [
        {
          "id": "w0",
          "text": "ディレクショナルライトは、",
          "start": 0.05,
          "end": 2.487
        },
        {
          "id": "w1",
          "text": "無限遠から降り注ぐ平行光線。",
          "start": 2.487,
          "end": 5.111
        },
        {
          "id": "w2",
          "text": "太陽や月の抽象化だ。",
          "start": 5.111,
          "end": 6.986
        },
        {
          "id": "w3",
          "text": "位置は持たず、",
          "start": 6.986,
          "end": 8.298
        },
        {
          "id": "w4",
          "text": "方向だけを持つ。",
          "start": 8.298,
          "end": 9.798
        },
        {
          "id": "w5",
          "text": "だから減衰しない。",
          "start": 9.798,
          "end": 11.485
        },
        {
          "id": "w6",
          "text": "屋外のシーンでは、",
          "start": 11.485,
          "end": 13.172
        },
        {
          "id": "w7",
          "text": "これが主光源になる。",
          "start": 13.172,
          "end": 15.047
        }
      ]
    },
    {
      "id": "06",
      "path": "assets/voice/06.wav",
      "duration_s": 15.648,
      "words": [
        {
          "id": "w0",
          "text": "方向と色温度を変えるだけで、",
          "start": 0.05,
          "end": 2.434
        },
        {
          "id": "w1",
          "text": "時間帯が作れる。",
          "start": 2.434,
          "end": 3.797
        },
        {
          "id": "w2",
          "text": "真上の白は正午、",
          "start": 3.797,
          "end": 5.159
        },
        {
          "id": "w3",
          "text": "低いオレンジは夕暮れ。",
          "start": 5.159,
          "end": 7.033
        },
        {
          "id": "w4",
          "text": "影はカスケードシャドウマップで、",
          "start": 7.033,
          "end": 9.758
        },
        {
          "id": "w5",
          "text": "近くほど高解像度に。",
          "start": 9.758,
          "end": 11.461
        },
        {
          "id": "w6",
          "text": "タイムオブデイの基本は、",
          "start": 11.461,
          "end": 13.504
        },
        {
          "id": "w7",
          "text": "この2つのパラメータだ。",
          "start": 13.504,
          "end": 15.548
        }
      ]
    },
    {
      "id": "07",
      "path": "assets/voice/07.wav",
      "duration_s": 16.299,
      "words": [
        {
          "id": "w0",
          "text": "環境光は、",
          "start": 0.05,
          "end": 1.099
        },
        {
          "id": "w1",
          "text": "空全体からの回り込みを近似する光。",
          "start": 1.099,
          "end": 4.664
        },
        {
          "id": "w2",
          "text": "特定の光源を持たない。",
          "start": 4.664,
          "end": 6.971
        },
        {
          "id": "w3",
          "text": "一番単純な形は、",
          "start": 6.971,
          "end": 8.649
        },
        {
          "id": "w4",
          "text": "空の色を一定量、",
          "start": 8.649,
          "end": 10.327
        },
        {
          "id": "w5",
          "text": "全ピクセルに足すこと。",
          "start": 10.327,
          "end": 12.634
        },
        {
          "id": "w6",
          "text": "この光が、",
          "start": 12.634,
          "end": 13.682
        },
        {
          "id": "w7",
          "text": "影の中を真っ黒にしない。",
          "start": 13.682,
          "end": 16.199
        }
      ]
    },
    {
      "id": "08",
      "path": "assets/voice/08.wav",
      "duration_s": 12.715,
      "words": [
        {
          "id": "w0",
          "text": "現代のゲームはイメージベースドライティング。",
          "start": 0.05,
          "end": 3.889
        },
        {
          "id": "w1",
          "text": "空の画像そのものを光源にする。",
          "start": 3.889,
          "end": 6.507
        },
        {
          "id": "w2",
          "text": "さらにアンビエントオクルージョンで、",
          "start": 6.507,
          "end": 9.648
        },
        {
          "id": "w3",
          "text": "隙間や凹みを暗くして立体感を出す。",
          "start": 9.648,
          "end": 12.615
        }
      ]
    },
    {
      "id": "09",
      "path": "assets/voice/09.wav",
      "duration_s": 11.601,
      "words": [
        {
          "id": "w0",
          "text": "役割分担はこうだ。",
          "start": 0.05,
          "end": 1.768
        },
        {
          "id": "w1",
          "text": "ディレクショナルが主光源。",
          "start": 1.768,
          "end": 4.249
        },
        {
          "id": "w2",
          "text": "点光源がアクセント。",
          "start": 4.249,
          "end": 6.157
        },
        {
          "id": "w3",
          "text": "環境光がベース。",
          "start": 6.157,
          "end": 7.684
        },
        {
          "id": "w4",
          "text": "3つのバランスが、",
          "start": 7.684,
          "end": 9.402
        },
        {
          "id": "w5",
          "text": "画作りの出発点になる。",
          "start": 9.402,
          "end": 11.501
        }
      ]
    },
    {
      "id": "10",
      "path": "assets/voice/10.wav",
      "duration_s": 11.71,
      "words": [
        {
          "id": "w0",
          "text": "次にシーンを開いたら、",
          "start": 0.05,
          "end": 2.756
        },
        {
          "id": "w1",
          "text": "まず光を3つに分けて見てみよう。",
          "start": 2.756,
          "end": 6.691
        },
        {
          "id": "w2",
          "text": "それだけで、",
          "start": 6.691,
          "end": 8.167
        },
        {
          "id": "w3",
          "text": "シーンの見方が変わるはずだ。",
          "start": 8.167,
          "end": 11.61
        }
      ]
    }
  ],
